{
  "version": 1,
  "name": "s2_preset_bezier_2000000",
  "algorithm": "uav-interception-mappo-v4",
  "environment": {
    "task": "S2",
    "evader_mode": "preset_bezier"
  },
  "training": {
    "seed": 17,
    "workers": 4,
    "horizon": 128
  },
  "total_joint_steps": 2000000,
  "log_interval": 16,
  "evaluation": {
    "interval_joint_steps": 65536,
    "evaluation_episodes": 10,
    "evaluation_seed_base": 2200,
    "evaluation_scenario": "random",
    "evaluation_deterministic": true
  },
  "checkpoint": "latest_best",
  "test": {
    "enabled": true,
    "scenario": "random",
    "seed": 10010000,
    "episodes": 200,
    "deterministic": true,
    "checkpoint": "best"
  },
  "storage": {
    "trajectories": "none"
  },
  "report": {
    "on_complete": false,
    "plots": true
  }
}
